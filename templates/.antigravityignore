# Zero Slop ignore list for Antigravity / Gemini CLI agents.
# Copy to a project root as `.antigravityignore` (installer also writes `.geminiignore`).
# Out of bounds for indexing, reading, and searching.
# NOTE: this is a request to the agent, not OS-level protection. Keep real secrets out of the repo.

# Secrets & keys
.env
.env.*
!.env.example
!.env.sample
*.pem
*.key
*.p12
*.pfx
*.keystore
id_rsa*
id_ed25519*
.npmrc
.pypirc
.netrc
credentials*.json
service-account*.json
secrets/
secrets.json
secrets.y*ml
secrets.toml
*.secret

# Dependencies & environments
node_modules/
**/node_modules/
vendor/
**/vendor/
.venv/
venv/
**/__pycache__/
.pnp/
.pnp.*

# Build & cache
dist/
**/dist/
build/
**/build/
.next/
**/.next/
.dart_tool/
**/.dart_tool/
.gradle/
**/.gradle/
**/ios/Pods/
target/
coverage/
.cache/
out/

# Git, logs & lockfiles
# Lockfiles are skipped for indexing; version-lock-guard may look up ONE package in them.
.git/
**/.git/
*.lock
package-lock.json
**/package-lock.json
yarn.lock
pnpm-lock.yaml
pubspec.lock
composer.lock
**/*.log

# Dumps, archives & heavy binaries (migrations/*.sql stay readable)
*dump*.sql
*backup*.sql
*.sql.gz
*.sqlite
*.sqlite3
*.db
backups/
*.zip
*.tar
*.tar.gz
*.tar.xz
*.7z
*.rar
*.mp4
*.mov
*.mp3
*.wav
*.pdf

# Test artifacts
**/playwright-report/
**/test-results/
**/screenshots/
**/traces/
